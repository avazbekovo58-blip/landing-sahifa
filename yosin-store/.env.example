# =============================================================
# Yosin Store — environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================

# ---- Domain (points to your VPS; required for HTTPS + Telegram) ----
DOMAIN=shop.example.com

# ---- PostgreSQL ----
POSTGRES_USER=yosin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=yosin_store

# ---- Telegram bot (from @BotFather) ----
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# ---- Anthropic (AI sales assistant) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ---- n8n ----
# Generate once, keep stable: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change_me_random_hex

# ---- Admin panel ----
ADMIN_PASSWORD=change_me_admin_password

# ---- Mini App build-time (frontend) ----
# Leave VITE_API_BASE empty to use the built-in demo mock data (no backend needed).
# Set to https://${DOMAIN}/api once n8n webhooks are live.
VITE_API_BASE=
